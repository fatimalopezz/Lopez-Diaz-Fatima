<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="440.0" prefHeight="390.0"
            style="-fx-background-color: #F4F4F4;"
            xmlns="http://javafx.com/javafx/23.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fatima.ejercicio1.dinero.Controlador">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="34.0"
              style="-fx-background-color: #E5E5E5;
                     -fx-border-color: #B5B5B5;
                     -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets left="12.0" right="8.0"/>
            </padding>
            <Label text="Desglose de dinero"
                   style="-fx-font-size: 16px; -fx-text-fill: #555555;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets top="18.0" right="12.0" bottom="12.0" left="12.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="9.0">
                <Label text="Dinero:"
                       style="-fx-font-size: 16px;"/>

                <TextField fx:id="txtDinero"
                           text="9999"
                           prefWidth="145.0"
                           prefHeight="34.0"
                           alignment="CENTER_RIGHT"
                           style="-fx-font-size: 16px;"/>

                <Button text="X"
                        onAction="#limpiar"
                        prefWidth="35.0"
                        prefHeight="34.0"
                        style="-fx-font-size: 16px;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Desglosar"
                        onAction="#desglosar"
                        prefWidth="115.0"
                        prefHeight="38.0"
                        style="-fx-font-size: 16px;"/>
            </HBox>

            <HBox spacing="32.0" alignment="CENTER"
                  VBox.vgrow="ALWAYS">

                <VBox alignment="CENTER_RIGHT" spacing="0.0"
                      prefWidth="230.0" minWidth="230.0"
                      style="-fx-border-color: #777777;
                             -fx-border-width: 1.5;
                             -fx-background-color: white;">
                    <padding>
                        <Insets top="6.0" right="12.0"
                                bottom="6.0" left="6.0"/>
                    </padding>

                    <Label text="Billetes de $500"
                           prefHeight="27.0"
                           style="-fx-font-size: 17px;"/>
                    <Label text="Billetes de $200"
                           prefHeight="27.0"
                           style="-fx-font-size: 17px;"/>
                    <Label text="Billetes de $100"
                           prefHeight="27.0"
                           style="-fx-font-size: 17px;"/>
                    <Label text="Billetes de $50"
                           prefHeight="27.0"
                           style="-fx-font-size: 17px;"/>
                    <Label text="Billetes de $20"
                           prefHeight="27.0"
                           style="-fx-font-size: 17px;"/>
                    <Label text="Monedas de $10"
                           prefHeight="27.0"
                           style="-fx-font-size: 17px;"/>
                    <Label text="Monedas de $5"
                           prefHeight="27.0"
                           style="-fx-font-size: 17px;"/>
                    <Label text="Monedas de $2"
                           prefHeight="27.0"
                           style="-fx-font-size: 17px;"/>
                    <Label text="Monedas de $1"
                           prefHeight="27.0"
                           style="-fx-font-size: 17px;"/>
                </VBox>

                <VBox spacing="0.0"
                      prefWidth="190.0" minWidth="190.0"
                      style="-fx-border-color: #777777;
                             -fx-border-width: 1.5;
                             -fx-background-color: white;">
                    <padding>
                        <Insets top="6.0" left="12.0"
                                right="6.0" bottom="6.0"/>
                    </padding>

                    <Label fx:id="lbl500" text="0"
                           prefHeight="27.0"
                           style="-fx-font-size: 17px;"/>
                    <Label fx:id="lbl200" text="0"
                           prefHeight="27.0"
                           style="-fx-font-size: 17px;"/>
                    <Label fx:id="lbl100" text="0"
                           prefHeight="27.0"
                           style="-fx-font-size: 17px;"/>
                    <Label fx:id="lbl50" text="0"
                           prefHeight="27.0"
                           style="-fx-font-size: 17px;"/>
                    <Label fx:id="lbl20" text="0"
                           prefHeight="27.0"
                           style="-fx-font-size: 17px;"/>
                    <Label fx:id="lbl10" text="0"
                           prefHeight="27.0"
                           style="-fx-font-size: 17px;"/>
                    <Label fx:id="lbl5" text="0"
                           prefHeight="27.0"
                           style="-fx-font-size: 17px;"/>
                    <Label fx:id="lbl2" text="0"
                           prefHeight="27.0"
                           style="-fx-font-size: 17px;"/>
                    <Label fx:id="lbl1" text="0"
                           prefHeight="27.0"
                           style="-fx-font-size: 17px;"/>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <Region prefHeight="9.0"
                style="-fx-background-color: #E5E5E5;
                       -fx-border-color: #B5B5B5;
                       -fx-border-width: 1 0 0 0;"/>
    </bottom>

</BorderPane>
